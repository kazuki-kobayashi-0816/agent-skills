{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"; [ -f \"$SCRIPT\" ]&& bash \"$SCRIPT\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/big-read-guard.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/big-read-guard.sh\"; if [ -f \"$SCRIPT\" ]; then bash \"$SCRIPT\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/big-bash-read-guard.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/big-bash-read-guard.sh\"; if [ -f \"$SCRIPT\" ]; then bash \"$SCRIPT\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/main-edit-guard.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/main-edit-guard.sh\"; if [ -f \"$SCRIPT\" ]; then bash \"$SCRIPT\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/tdd-boundary-guard.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tdd-boundary-guard.sh\"; if [ -f \"$SCRIPT\" ]; then bash \"$SCRIPT\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/tdd-boundary-audit.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tdd-boundary-audit.sh\"; if [ -f \"$SCRIPT\" ]; then bash \"$SCRIPT\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PLUGIN_ROOT}/hooks/tdd-boundary-audit.sh\"; [ -f \"$SCRIPT\" ] || SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tdd-boundary-audit.sh\"; if [ -f \"$SCRIPT\" ]; then bash \"$SCRIPT\"; fi",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
